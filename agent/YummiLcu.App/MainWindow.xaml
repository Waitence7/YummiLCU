<Window x:Class="YummiLcu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toasts="clr-namespace:YummiLcu.App.Infrastructure.Toasts"
        Title="Yummi LCU"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
  <Border Background="{DynamicResource LcuBg}"
          BorderBrush="{DynamicResource LcuAccent}"
          BorderThickness="1"
          CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Custom title bar -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource LcuPanel}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource LcuAccent}" IsHitTestVisible="False" Panel.ZIndex="0" Visibility="{Binding EnableAtmosphereReactions, Converter={StaticResource BoolToVis}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Opacity" Value="0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Active">
                  <Setter Property="Opacity" Value="0.05" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.02" To="0.08" Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="2x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Alert">
                  <Setter Property="Opacity" Value="0.12" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.02" To="0.18" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="3x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Focused">
                  <Setter Property="Opacity" Value="0.08" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Result">
                  <Setter Property="Opacity" Value="0.08" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.12" Duration="0:0:0.22" AutoReverse="True" RepeatBehavior="2x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Text="Yummi LCU" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource LcuAccent}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LeagueProcessHint}" FontSize="11"
                     Foreground="{DynamicResource LcuSubAccent}" Margin="12,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding IsLcuConnected, StringFormat=LCU: {0}}" FontSize="11"
                     Foreground="{DynamicResource LcuSubAccent}" Margin="12,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentGameState, StringFormat=Game: {0}}" FontSize="11"
                     Foreground="{DynamicResource LcuSubAccent}" Margin="12,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                  Content="&#x2013;" Click="MinimizeButton_Click" ToolTip="최소화" />
          <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}"
                  Content="&#x2715;" Click="CloseButton_Click" ToolTip="닫기" />
        </StackPanel>
      </Grid>

      <!-- Main (blur target) -->
      <Grid x:Name="MainContentRoot" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" Background="{DynamicResource LcuAccent}" IsHitTestVisible="False" Panel.ZIndex="0" Visibility="{Binding EnableAtmosphereReactions, Converter={StaticResource BoolToVis}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Opacity" Value="0.012" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Dimmed">
                  <Setter Property="Opacity" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Calm">
                  <Setter Property="Opacity" Value="0.012" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Active">
                  <Setter Property="Opacity" Value="0.025" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Alert">
                  <Setter Property="Opacity" Value="0.045" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Focused">
                  <Setter Property="Opacity" Value="0.035" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Resting">
                  <Setter Property="Opacity" Value="0.006" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentAtmosphereState}" Value="Result">
                  <Setter Property="Opacity" Value="0.03" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>

        <Border Grid.Column="0" Background="{DynamicResource LcuPanel}" BorderBrush="{DynamicResource LcuAccent}" BorderThickness="0,1,1,0">
          <DockPanel Margin="0,8">
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
              <Border Background="{DynamicResource LcuBg}" BorderBrush="{DynamicResource LcuAccent}"
                      BorderThickness="1" CornerRadius="4" Padding="8" Margin="8,4"
                      Visibility="{Binding TestMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="테스트 모드 ON&#10;롤·lockfile 없이 UI만 확인합니다."
                           Foreground="{DynamicResource LcuAccent}" FontSize="11" TextWrapping="Wrap" />
              </Border>
              <CheckBox Content="테스트 모드 (롤 불필요)" IsChecked="{Binding TestMode}"
                        Foreground="{DynamicResource LcuText}" Margin="8,8,8,4"
                        ToolTip="켜면 가짜 소환사·로비·챔프선택 데이터로 전체 화면을 테스트할 수 있습니다." />
              <Button Content="LCU 연결" Command="{Binding ConnectLcuCommand}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TestMode}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Relay 시작" Style="{StaticResource NavButtonStyle}" Command="{Binding StartRelayCommand}" />
              <Button Content="Relay 중지" Style="{StaticResource NavButtonStyle}" Command="{Binding StopRelayCommand}" />
              <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource LcuSubAccent}" TextWrapping="Wrap" Margin="12,8" FontSize="11" />
              <TextBlock Text="테마" Foreground="{DynamicResource LcuText}" Margin="12,12,12,4" />
              <Button Content="고양이" Style="{StaticResource NavButtonStyle}" Command="{Binding SetCatThemeCommand}" />
              <Button Content="사이버" Style="{StaticResource NavButtonStyle}" Command="{Binding SetCyberThemeCommand}" />
              <Button Content="클래식" Style="{StaticResource NavButtonStyle}" Command="{Binding SetClassicThemeCommand}" />
            </StackPanel>

            <StackPanel Margin="8,0">
              <Button Content="홈" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateHomeCommand}" Tag="{Binding IsHomeActive}" />
              <Button Content="로비" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateLobbyCommand}" Tag="{Binding IsLobbyActive}" />
              <Button Content="챔프 선택" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateChampSelectCommand}" Tag="{Binding IsChampSelectActive}" />
              <Button Content="설정" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateSettingsCommand}" Tag="{Binding IsSettingsActive}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="16"
                        Content="{Binding CurrentViewModel}" Opacity="1" />

        <Border Grid.Column="2" Background="{DynamicResource LcuPanel}" BorderBrush="{DynamicResource LcuAccent}" BorderThickness="1,1,0,0" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="로그" FontWeight="SemiBold" Foreground="{DynamicResource LcuAccent}" Margin="0,0,0,8" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding LogText}" Foreground="{DynamicResource LcuText}" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Toasts}" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" Panel.ZIndex="40">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="320" Margin="0,0,0,8" Padding="12,10" Background="{DynamicResource LcuPanel}"
                      BorderThickness="1" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.96" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LcuAccent}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Success}">
                        <Setter Property="BorderBrush" Value="#7ADCA6" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Warning}">
                        <Setter Property="BorderBrush" Value="#E5C767" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Error}">
                        <Setter Property="BorderBrush" Value="#E06C75" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsClosing}" Value="True">
                        <DataTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="18" Duration="0:0:0.16" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Border.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.96" Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="18" To="0" Duration="0:0:0.16" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Border.Triggers>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Top" Margin="0,1,8,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="i" />
                        <Setter Property="Foreground" Value="{DynamicResource LcuAccent}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Success}">
                            <Setter Property="Text" Value="+" />
                            <Setter Property="Foreground" Value="#7ADCA6" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Warning}">
                            <Setter Property="Text" Value="!" />
                            <Setter Property="Foreground" Value="#E5C767" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Type}" Value="{x:Static toasts:ToastType.Error}">
                            <Setter Property="Text" Value="x" />
                            <Setter Property="Foreground" Value="#E06C75" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource LcuText}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource LcuSubAccent}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="x" Style="{StaticResource TitleBarButtonStyle}" Width="24" Height="24"
                          Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" ToolTip="Dismiss" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pet placeholder -->
        <Border x:Name="PetPlaceholder" Visibility="{Binding EnablePetPlaceholder, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="3" Width="78" Height="78"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"
                Background="{DynamicResource LcuPanel}" BorderBrush="{DynamicResource LcuAccent}"
                BorderThickness="1" CornerRadius="8" Cursor="Hand"
                ToolTip="Yummi" Panel.ZIndex="20">
          <Border.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
              <RotateTransform x:Name="PetRotate" Angle="0" />
              <TranslateTransform x:Name="PetTranslate" X="0" Y="0" />
            </TransformGroup>
          </Border.RenderTransform>
          <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Setter Property="Opacity" Value="0.86" />
              <Setter Property="IsHitTestVisible" Value="True" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Idle">
                  <Setter Property="Opacity" Value="0.86" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)" To="0" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" To="0" Duration="0:0:0.16" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Waiting">
                  <Setter Property="Opacity" Value="0.9" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)" From="-4" To="4" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="3x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Excited">
                  <Setter Property="Opacity" Value="1" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1" To="1.12" Duration="0:0:0.11" AutoReverse="True" RepeatBehavior="2x" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1" To="1.12" Duration="0:0:0.11" AutoReverse="True" RepeatBehavior="2x" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)" From="0" To="-7" Duration="0:0:0.11" AutoReverse="True" RepeatBehavior="2x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Focused">
                  <Setter Property="Opacity" Value="1" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.16" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Sleeping">
                  <Setter Property="Opacity" Value="0.52" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)" To="5" Duration="0:0:0.35" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.35" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.35" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Curious">
                  <Setter Property="Opacity" Value="0.94" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" From="0" To="-7" Duration="0:0:0.16" AutoReverse="True" RepeatBehavior="2x" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPetState}" Value="Hidden">
                  <Setter Property="Opacity" Value="0" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12" />
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeftButtonDown">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1" To="1.16" Duration="0:0:0.09" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1" To="0.9" Duration="0:0:0.09" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)" From="0" To="-6" Duration="0:0:0.09" AutoReverse="True" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Grid>
            <TextBlock Text=":3" Foreground="{DynamicResource LcuAccent}" FontSize="24"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentPetState}" Foreground="{DynamicResource LcuSubAccent}"
                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
          </Grid>
        </Border>
      </Grid>

      <!-- Modal overlay -->
      <Grid x:Name="ModalLayer" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="#66000000" />
        <ContentControl x:Name="ModalContentPresenter"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
