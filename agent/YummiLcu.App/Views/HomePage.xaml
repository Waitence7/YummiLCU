<UserControl x:Class="YummiLcu.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource LcuPanel}" BorderBrush="{DynamicResource LcuAccent}"
            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12"
            Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="테스트 모드 — 시뮬레이션 데이터입니다. 좌측 체크박스를 끄면 실제 LCU에 연결할 수 있습니다."
                 Foreground="{DynamicResource LcuSubAccent}" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <Grid Grid.Row="1">
      <!-- Skeleton / loading -->
      <Border Style="{StaticResource GamePanelBorder}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Border Height="28" Width="120" Style="{StaticResource SkeletonBlockStyle}" Margin="0,0,0,16" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="72" Height="72" Style="{StaticResource SkeletonBlockStyle}" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center" Width="200">
              <Border Height="20" Style="{StaticResource SkeletonBlockStyle}" Margin="0,0,0,8" />
              <Border Height="14" Width="80" Style="{StaticResource SkeletonBlockStyle}" />
            </StackPanel>
          </StackPanel>
          <Border Height="64" Style="{StaticResource SkeletonBlockStyle}" Margin="0,8,0,0" />
          <ProgressBar Style="{StaticResource ProgressRingStyle}" HorizontalAlignment="Center" Margin="0,20,0,0" />
          <TextBlock Text="LCU에서 정보 불러오는 중…" Foreground="{DynamicResource LcuSubAccent}"
                     HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Content -->
      <Border Style="{StaticResource GamePanelBorder}"
              Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
              Opacity="{Binding ContentOpacity}">
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <StackPanel>
          <TextBlock Text="내 정보" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource LcuAccent}" Margin="0,0,0,16" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="72" Height="72" Background="{DynamicResource LcuBg}" CornerRadius="4" Margin="0,0,16,0">
              <Image Source="{Binding ProfileIcon}" Stretch="UniformToFill" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SummonerName}" FontSize="18" Foreground="{DynamicResource LcuText}" />
              <TextBlock Text="{Binding SummonerLevel}" Foreground="{DynamicResource LcuSubAccent}" />
              <TextBlock Text="{Binding Availability}" Foreground="{DynamicResource LcuAccent}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="상태 메시지" Foreground="{DynamicResource LcuText}" Margin="0,8,0,4" />
          <TextBox Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LcuTextBoxStyle}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" />
          <Button Content="상메 저장" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"
                  Command="{Binding SaveStatusCommand}" />
          <Separator Margin="0,20,0,12" Background="{DynamicResource LcuSubAccent}" Opacity="0.3" />
          <StackPanel x:Name="LockfilePanel">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTestMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="lockfile" Foreground="{DynamicResource LcuText}" />
            <TextBox Text="{Binding LockfilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LcuTextBoxStyle}" Margin="0,4,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="LCU 연결" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConnectLcuCommand}" Margin="0,0,8,0" />
              <Button Content="새로고침" Style="{StaticResource NavButtonStyle}" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </StackPanel>
          <Button Content="새로고침" Command="{Binding RefreshCommand}" Margin="0,8,0,0" HorizontalAlignment="Left">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTestMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
