<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid x:Name="HudPanel" Background="Transparent">
      <Border x:Name="LcuPanel"
              Width="240"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="20,20,0,0"
              Padding="12"
              CornerRadius="12"
              Background="#E6141020"
              BorderBrush="#507B5AA6"
              BorderThickness="1"
              PointerPressed="Panel_PointerPressed"
              PointerMoved="Panel_PointerMoved"
              PointerReleased="Panel_PointerReleased"
              PointerCanceled="Panel_PointerCanceled"
              PointerCaptureLost="Panel_PointerCaptureLost">
        <Border.RenderTransform>
          <TranslateTransform x:Name="LcuPanelTransform"/>
        </Border.RenderTransform>
        <StackPanel Spacing="7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A6A86" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="LCU 상태" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="VersionText" Text="v-" FontSize="9" Foreground="#9687AA" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="PhaseText" Grid.Column="2" Text="Offline" FontSize="10" Foreground="#CDBDE8" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="9" Foreground="#A99DBB" TextWrapping="Wrap"/>
          <TextBlock x:Name="DisplayText" FontSize="8" Foreground="#776E84" TextWrapping="Wrap"/>
          <TextBlock x:Name="InputText" FontSize="8" Foreground="#9388A3" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border x:Name="PartyPanel"
              Width="240"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="20,190,0,0"
              Padding="12"
              CornerRadius="12"
              Background="#E6141020"
              BorderBrush="#507B5AA6"
              BorderThickness="1"
              PointerPressed="Panel_PointerPressed"
              PointerMoved="Panel_PointerMoved"
              PointerReleased="Panel_PointerReleased"
              PointerCanceled="Panel_PointerCanceled"
              PointerCaptureLost="Panel_PointerCaptureLost">
        <Border.RenderTransform>
          <TranslateTransform x:Name="PartyPanelTransform"/>
        </Border.RenderTransform>
        <StackPanel Spacing="7">
          <TextBlock Text="파티" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="PartyText" Text="파티 정보 없음" FontSize="11" Foreground="#BDB1D0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border x:Name="YoutubePanel"
              Width="340"
              Height="191"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="280,20,0,0"
              CornerRadius="10"
              Background="#FF000000"
              BorderBrush="#507B5AA6"
              BorderThickness="1">
        <Border.RenderTransform>
          <TranslateTransform x:Name="YoutubePanelTransform"/>
        </Border.RenderTransform>
        <Grid x:Name="YoutubeVideoHost" Background="Black">
          <Grid x:Name="YoutubeWebHost">
            <WebView x:Name="YoutubeFallbackWebView"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Visibility="Collapsed"
                     NavigationCompleted="YoutubeFallbackWebView_NavigationCompleted"/>
          </Grid>
          <Border x:Name="YoutubeInlineState" Background="#C8120F1C" Visibility="Visible">
            <TextBlock x:Name="YoutubeInlineStateText"
                       Text="설정에서 YouTube 영상을 선택해 주세요"
                       Foreground="#D9CFE8"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"/>
          </Border>
          <!-- 메인 오버레이에서는 영상 전체가 이동 핸들이다. 영상 조작은 설정 화면에서 한다. -->
          <Border x:Name="YoutubeDragSurface"
                  Background="#01000000"
                  PointerPressed="YoutubeDragSurface_PointerPressed"
                  PointerMoved="YoutubeDragSurface_PointerMoved"
                  PointerReleased="YoutubeDragSurface_PointerReleased"
                  PointerCanceled="YoutubeDragSurface_PointerCanceled"
                  PointerCaptureLost="YoutubeDragSurface_PointerCaptureLost"/>
          <!-- 우하단의 넓은 그립으로 YouTube 패널 자체를 16:9 비율로 확대/축소한다. -->
          <Border x:Name="YoutubeResizeGrip"
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="#990E0B17"
                  BorderBrush="#80FFFFFF"
                  BorderThickness="1,1,0,0"
                  CornerRadius="8,0,10,0"
                  PointerPressed="YoutubeResizeGrip_PointerPressed"
                  PointerMoved="YoutubeResizeGrip_PointerMoved"
                  PointerReleased="YoutubeResizeGrip_PointerReleased"
                  PointerCanceled="YoutubeResizeGrip_PointerCanceled"
                  PointerCaptureLost="YoutubeResizeGrip_PointerCaptureLost">
            <TextBlock Text="↘" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
