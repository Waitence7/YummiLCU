<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Border
        x:Name="HudPanel"
        Width="330"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="36"
        Padding="14"
        CornerRadius="12"
        Background="#D9141020"
        BorderBrush="#507B5AA6"
        BorderThickness="1">
      <StackPanel Spacing="7">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A6A86" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="유미 LCU" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="PhaseText" Text="Offline" FontSize="11" Foreground="#CDBDE8" Margin="10,4,0,0"/>
        </StackPanel>
        <TextBlock x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="PartyText" Text="파티 정보 없음" FontSize="11" Foreground="#BDB1D0" TextWrapping="Wrap"/>
        <TextBlock x:Name="DisplayText" FontSize="10" Foreground="#877C98" TextWrapping="Wrap"/>
        <TextBlock x:Name="InputText" FontSize="10" Foreground="#BDB1D0" TextWrapping="Wrap"/>
        <TextBlock x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="10" Foreground="#877C98" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</Page>
