<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#E8141020" Padding="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A6A86" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="유미 LCU" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="PhaseText" Text="Offline" FontSize="12" Foreground="#CDBDE8" Margin="10,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#28FFFFFF" CornerRadius="6" Padding="7,3" ToolTipService.ToolTip="Win+G를 연 뒤 위젯 제목 표시줄을 끌어 위치를 옮길 수 있습니다.">
        <TextBlock Text="↕ 이동" FontSize="10" Foreground="#BDAFD3"/>
      </Border>
    </Grid>

    <TextBlock Grid.Row="1" x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="14" Foreground="White" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    <Border Grid.Row="2" Height="1" Background="#35FFFFFF" Margin="0,12,0,10"/>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <TextBlock Text="파티" FontSize="12" Foreground="#AFA3C8" Margin="0,0,0,2"/>
        <ItemsControl x:Name="PartyList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#F3EDFF" FontSize="13" Margin="0,2" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyPartyText" Text="파티 정보 없음" FontSize="12" Foreground="#80778F"/>

        <Border Height="1" Background="#28FFFFFF" Margin="0,6"/>
        <TextBlock Text="LCU 조작 테스트" FontSize="12" Foreground="#AFA3C8"/>
        <TextBlock Text="상태 메시지" FontSize="11" Foreground="#BDB1D0"/>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox
              x:Name="StatusMessageInput"
              PlaceholderText="새 상태 메시지 입력"
              MaxLength="128"
              AcceptsReturn="False"
              HorizontalAlignment="Stretch"/>
          <Button
              x:Name="StatusMessageButton"
              Grid.Column="1"
              Content="상메 적용"
              Click="StatusMessageButton_Click"/>
        </Grid>
        <TextBlock x:Name="StatusMessageResultText" Text="실제 LCU에 적용되는 테스트 기능입니다." FontSize="10" Foreground="#8F82A3" TextWrapping="Wrap"/>

        <Border Height="1" Background="#28FFFFFF" Margin="0,6"/>
        <TextBlock Text="입력 테스트" FontSize="12" Foreground="#AFA3C8"/>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="ClickTestButton" Content="클릭 테스트" Click="ClickTestButton_Click" HorizontalAlignment="Stretch"/>
          <Button Grid.Column="1" Content="초기화" Click="ResetTests_Click" HorizontalAlignment="Stretch"/>
        </Grid>
        <TextBlock x:Name="ClickCountText" Text="클릭 0회" FontSize="11" Foreground="#BDB1D0"/>

        <ToggleSwitch x:Name="ToggleTest" Header="토글 테스트" OffContent="꺼짐" OnContent="켜짐" Toggled="ToggleTest_Toggled"/>

        <StackPanel>
          <TextBlock x:Name="SliderValueText" Text="슬라이더 · 50" FontSize="11" Foreground="#BDB1D0"/>
          <Slider x:Name="TestSlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1" ValueChanged="TestSlider_ValueChanged"/>
        </StackPanel>

        <Border
            x:Name="GestureCard"
            Background="#4A7652A8"
            BorderBrush="#907D5DB1"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Margin="0,2,0,0"
            ManipulationMode="TranslateX,TranslateY,TranslateInertia"
            ManipulationStarted="GestureCard_ManipulationStarted"
            ManipulationDelta="GestureCard_ManipulationDelta"
            ManipulationCompleted="GestureCard_ManipulationCompleted"
            Tapped="GestureCard_Tapped"
            DoubleTapped="GestureCard_DoubleTapped"
            RightTapped="GestureCard_RightTapped">
          <Border.RenderTransform>
            <TranslateTransform x:Name="GestureTranslate"/>
          </Border.RenderTransform>
          <StackPanel>
            <TextBlock Text="드래그 / 스와이프 테스트" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="이 카드를 마우스나 터치로 끌어보세요" Foreground="#D6C9EA" FontSize="11" Margin="0,4,0,0"/>
            <TextBlock x:Name="GestureText" Text="대기 중" Foreground="#B9A8D2" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Button x:Name="DetailsButton" Content="테스트 상세 펼치기" Click="DetailsButton_Click" HorizontalAlignment="Stretch"/>
        <Border x:Name="DetailsPanel" Visibility="Collapsed" Background="#251F1732" CornerRadius="8" Padding="10">
          <StackPanel>
            <TextBlock Text="스크롤 테스트 영역" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Game Bar가 열린 상태에서 휠/터치 스크롤, 클릭, 드래그 입력을 동시에 확인할 수 있습니다." TextWrapping="Wrap" Foreground="#BDB1D0" FontSize="11" Margin="0,5,0,0"/>
            <TextBlock Text="1 · 클릭 / 더블클릭 / 우클릭" Foreground="#AFA3C8" FontSize="11" Margin="0,8,0,0"/>
            <TextBlock Text="2 · ToggleSwitch" Foreground="#AFA3C8" FontSize="11"/>
            <TextBlock Text="3 · Slider" Foreground="#AFA3C8" FontSize="11"/>
            <TextBlock Text="4 · 카드 드래그 / 스와이프" Foreground="#AFA3C8" FontSize="11"/>
            <TextBlock Text="5 · 세로 스크롤" Foreground="#AFA3C8" FontSize="11"/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="InputStatusText" Text="아직 입력 없음" FontSize="11" Foreground="#9F91B5" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="4" x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="11" Foreground="#877C98" Margin="0,10,0,0" TextWrapping="Wrap"/>

    <Border
        x:Name="FriendOnlineToast"
        Grid.RowSpan="5"
        Canvas.ZIndex="100"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Width="265"
        Margin="0,46,0,0"
        Padding="12"
        CornerRadius="10"
        Background="#F02A203A"
        BorderBrush="#807B5AA6"
        BorderThickness="1"
        Visibility="Collapsed"
        Opacity="0">
      <Border.RenderTransform>
        <TranslateTransform x:Name="FriendToastTranslate" X="36"/>
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="10" Height="10" Fill="#56DD8B" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="친구 접속" Foreground="#AFA3C8" FontSize="10"/>
          <TextBlock x:Name="FriendOnlineToastText" Text="누군가 접속했습니다" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
