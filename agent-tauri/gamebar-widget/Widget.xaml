<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Background="Transparent">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Border
        x:Name="HudPanel"
        Width="330"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="36"
        Padding="14"
        CornerRadius="12"
        Background="#D9141020"
        BorderBrush="#507B5AA6"
        BorderThickness="1">
      <StackPanel Spacing="7">
        <Grid x:Name="HudDragHandle"
              Background="#01000000"
              PointerPressed="HudDragHandle_PointerPressed"
              PointerMoved="HudDragHandle_PointerMoved"
              PointerReleased="HudDragHandle_PointerReleased"
              PointerCanceled="HudDragHandle_PointerCanceled"
              PointerCaptureLost="HudDragHandle_PointerCaptureLost">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10" Fill="#7A6A86" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="유미 LCU" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="v-" FontSize="10" Foreground="#9687AA" VerticalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="PhaseText" Grid.Column="2" Text="Offline" FontSize="11" Foreground="#CDBDE8" Margin="10,4,0,0" VerticalAlignment="Center"/>
          <Button x:Name="HudResetPositionButton" Grid.Column="3" Content="↺" Width="28" Height="26" Padding="0" FontSize="13" Click="HudResetPositionButton_Click" ToolTipService.ToolTip="HUD 위치 초기화"/>
        </Grid>
        <TextBlock x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="PartyText" Text="파티 정보 없음" FontSize="11" Foreground="#BDB1D0" TextWrapping="Wrap"/>
        <TextBlock x:Name="DisplayText" FontSize="10" Foreground="#877C98" TextWrapping="Wrap"/>
        <TextBlock x:Name="InputText" FontSize="10" Foreground="#BDB1D0" TextWrapping="Wrap"/>
        <TextBlock x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="10" Foreground="#877C98" TextWrapping="Wrap"/>

        <Border Margin="0,6,0,0" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8" Background="#B30E0B17">
          <StackPanel Spacing="7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="YouTube" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
              <Button x:Name="YoutubeCollapseButton" Grid.Column="1" Content="접기" Padding="8,2" FontSize="10" Click="YoutubeCollapseButton_Click"/>
            </Grid>

            <StackPanel x:Name="YoutubeBody" Spacing="7">
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="YoutubeUrlBox" PlaceholderText="YouTube 링크 또는 영상 ID" FontSize="11" KeyDown="YoutubeUrlBox_KeyDown"/>
                <Button Grid.Column="1" Content="열기" Padding="12,4" FontSize="11" Click="YoutubeLoadButton_Click"/>
              </Grid>

              <Border Height="200" Background="#FF000000" CornerRadius="6">
                <Grid x:Name="YoutubeVideoHost">
                  <canvas:CanvasControl x:Name="BrowserCaptureCanvas" Visibility="Collapsed" Draw="BrowserCaptureCanvas_Draw"/>
                  <Grid x:Name="YoutubeWebHost">
                    <WebView x:Name="YoutubeFallbackWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" NavigationCompleted="YoutubeFallbackWebView_NavigationCompleted"/>
                  </Grid>
                  <Border x:Name="BrowserCaptureHint" Background="#B0000000" Visibility="Collapsed">
                    <TextBlock Text="브라우저 창을 선택해 주세요" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                  </Border>
                </Grid>
              </Border>

              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="▶" Width="36" Padding="4" Click="YoutubePlayButton_Click" ToolTipService.ToolTip="재생"/>
                <Button Grid.Column="1" Content="Ⅱ" Width="36" Padding="4" Click="YoutubePauseButton_Click" ToolTipService.ToolTip="일시정지"/>
                <TextBlock Grid.Column="2" Text="볼륨" FontSize="10" Foreground="#BDB1D0" VerticalAlignment="Center" Margin="4,0"/>
                <Slider x:Name="YoutubeVolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="60" ValueChanged="YoutubeVolumeSlider_ValueChanged"/>
              </Grid>
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="브라우저에서 열기" HorizontalAlignment="Stretch" Padding="8,4" FontSize="10" Click="YoutubeOpenBrowserButton_Click" ToolTipService.ToolTip="기본 브라우저에서 YouTube 열기"/>
                <Button Grid.Column="1" Content="브라우저 창 캡처" HorizontalAlignment="Stretch" Padding="8,4" FontSize="10" Click="YoutubeCaptureBrowserButton_Click" ToolTipService.ToolTip="브라우저 창을 Game Bar에 표시"/>
              </Grid>
              <TextBlock x:Name="YoutubeStatusText" Text="링크를 입력하면 영상이 표시됩니다" FontSize="10" Foreground="#877C98" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Page>
