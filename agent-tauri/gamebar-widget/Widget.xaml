<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Border
        x:Name="HudPanel"
        Width="600"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="20"
        Padding="12"
        CornerRadius="14"
        Background="#D9141020"
        BorderBrush="#507B5AA6"
        BorderThickness="1">
      <StackPanel Spacing="10">
        <Grid x:Name="HudDragHandle"
              Background="#01000000"
              PointerPressed="HudDragHandle_PointerPressed"
              PointerMoved="HudDragHandle_PointerMoved"
              PointerReleased="HudDragHandle_PointerReleased"
              PointerCanceled="HudDragHandle_PointerCanceled"
              PointerCaptureLost="HudDragHandle_PointerCaptureLost">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A6A86" VerticalAlignment="Center"/>
            <TextBlock Text="유미" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="v-" FontSize="10" Foreground="#9687AA" VerticalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="PhaseText" Grid.Column="1" Text="Offline" FontSize="11" Foreground="#CDBDE8" Margin="10,4,0,0" VerticalAlignment="Center"/>
          <Button x:Name="HudResetPositionButton" Grid.Column="2" Content="↺" Width="28" Height="26" Padding="0" FontSize="13" Click="HudResetPositionButton_Click" ToolTipService.ToolTip="위젯 위치 초기화"/>
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Spacing="10">
            <Border CornerRadius="10" Padding="11" Background="#B30E0B17" BorderBrush="#2FFFFFFF" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="LCU 상태" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="10" Foreground="#A99DBB" TextWrapping="Wrap"/>
                <TextBlock x:Name="DisplayText" FontSize="9" Foreground="#776E84" TextWrapping="Wrap"/>
                <TextBlock x:Name="InputText" FontSize="9" Foreground="#9388A3" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="11" Background="#B30E0B17" BorderBrush="#2FFFFFFF" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="파티" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="PartyText" Text="파티 정보 없음" FontSize="11" Foreground="#BDB1D0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" CornerRadius="10" Padding="0" Background="#FF000000" BorderBrush="#2FFFFFFF" BorderThickness="1">
            <Grid x:Name="YoutubeVideoHost" Background="Black">
              <Grid x:Name="YoutubeWebHost">
                <WebView x:Name="YoutubeFallbackWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" NavigationCompleted="YoutubeFallbackWebView_NavigationCompleted"/>
              </Grid>
              <Border x:Name="YoutubeInlineState" Background="#C8120F1C" Visibility="Visible">
                <TextBlock x:Name="YoutubeInlineStateText" Text="설정에서 YouTube 영상을 선택해 주세요" Foreground="#D9CFE8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Page>
