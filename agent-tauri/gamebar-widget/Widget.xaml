<Page
    x:Class="YummiGameBarWidget.Widget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Canvas x:Name="NativeCursorOverlay" IsHitTestVisible="False" Canvas.ZIndex="9999">
      <Grid x:Name="CursorMarkerPhysical" Visibility="Collapsed"><Ellipse Width="14" Height="14" Fill="#CCFF3B30" Stroke="White" StrokeThickness="1"/><TextBlock Text="P" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerLogical" Visibility="Collapsed"><Ellipse Width="12" Height="12" Fill="#CCFF9500" Stroke="White" StrokeThickness="1"/><TextBlock Text="L" Foreground="White" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerInfo" Visibility="Collapsed"><Ellipse Width="10" Height="10" Fill="#CCFFCC00" Stroke="White" StrokeThickness="1"/><TextBlock Text="C" Foreground="#FF202020" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerGameBarPrimary" Visibility="Collapsed"><Ellipse Width="14" Height="14" Fill="#CC34C759" Stroke="White" StrokeThickness="1"/><TextBlock Text="G1" Foreground="White" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerGameBarAlt" Visibility="Collapsed"><Ellipse Width="12" Height="12" Fill="#CC00C7BE" Stroke="White" StrokeThickness="1"/><TextBlock Text="G2" Foreground="White" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerGameBarStored" Visibility="Collapsed"><Ellipse Width="10" Height="10" Fill="#CCAF52DE" Stroke="White" StrokeThickness="1"/><TextBlock Text="GS" Foreground="White" FontSize="5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CursorMarkerSelected" Visibility="Collapsed"><Ellipse Width="18" Height="18" Fill="#663A86FF" Stroke="#FF3A86FF" StrokeThickness="2"/><TextBlock Text="S" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Canvas>
    <Grid x:Name="HudPanel" Background="Transparent">
      <Border x:Name="LcuPanel"
              Width="240"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="20,20,0,0"
              CornerRadius="12"
              Background="#E6141020"
              BorderBrush="#507B5AA6"
              BorderThickness="1">
        <Border.RenderTransform>
          <TranslateTransform x:Name="LcuPanelTransform"/>
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="LcuMoveBar"
                  Grid.Row="0"
                  Height="24"
                  Visibility="Collapsed"
                  Background="#E6141020"
                  BorderBrush="#507B5AA6"
                  BorderThickness="0,0,0,1"
                  Tag="lcu"
                  PointerPressed="PanelMoveBar_PointerPressed"
                  PointerMoved="PanelMoveBar_PointerMoved"
                  PointerReleased="PanelMoveBar_PointerReleased"
                  PointerCanceled="PanelMoveBar_PointerCanceled"
                  PointerCaptureLost="PanelMoveBar_PointerCaptureLost">
            <Grid Padding="8,0,3,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Yummi LCU" FontSize="11" Foreground="#D9CFE8" VerticalAlignment="Center"/>
              <Button x:Name="LcuEyeButton" Grid.Column="1" Tag="lcu" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="PanelEyeButton_Click" ToolTipService.ToolTip="LCU 내용 가리기/표시">
                <TextBlock x:Name="LcuEyeIcon" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
              </Button>
              <Button Grid.Column="2" Tag="lcu" Content="×" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="PanelCloseButton_Click" ToolTipService.ToolTip="LCU 패널 닫기"/>
            </Grid>
          </Border>
          <ScrollViewer x:Name="LcuBody"
                        Grid.Row="1"
                        Height="145"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel Padding="12" Spacing="7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A6A86" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="LCU 상태" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                  <TextBlock x:Name="VersionText" Text="v-" FontSize="9" Foreground="#9687AA" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PhaseText" Grid.Column="2" Text="Offline" FontSize="10" Foreground="#CDBDE8" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="RiotIdText" Text="League 클라이언트를 기다리는 중" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="BridgeText" Text="유미 에이전트 연결 확인 중…" FontSize="9" Foreground="#A99DBB" TextWrapping="Wrap"/>
              <TextBlock x:Name="DisplayText" FontSize="8" Foreground="#776E84" TextWrapping="Wrap"/>
              <TextBlock x:Name="InputText" FontSize="8" Foreground="#9388A3" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="LcuResizeHandles" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Tag="lcu:left" Width="7" HorizontalAlignment="Left" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Left" Background="#70FFFFFF"/></Border>
            <Border Tag="lcu:right" Width="7" HorizontalAlignment="Right" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Right" Background="#70FFFFFF"/></Border>
            <Border Tag="lcu:top" Height="7" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Top" Background="#70FFFFFF"/></Border>
            <Border Tag="lcu:bottom" Height="7" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Bottom" Background="#70FFFFFF"/></Border>
            <Border Tag="lcu:topleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="lcu:topright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="lcu:bottomleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="lcu:bottomright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="PartyPanel"
              Width="240"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="20,190,0,0"
              CornerRadius="12"
              Background="#E6141020"
              BorderBrush="#507B5AA6"
              BorderThickness="1">
        <Border.RenderTransform>
          <TranslateTransform x:Name="PartyPanelTransform"/>
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="PartyMoveBar" Grid.Row="0" Height="24" Visibility="Collapsed" Background="#E6141020" BorderBrush="#507B5AA6" BorderThickness="0,0,0,1" Tag="party"
                  PointerPressed="PanelMoveBar_PointerPressed" PointerMoved="PanelMoveBar_PointerMoved" PointerReleased="PanelMoveBar_PointerReleased" PointerCanceled="PanelMoveBar_PointerCanceled" PointerCaptureLost="PanelMoveBar_PointerCaptureLost">
            <Grid Padding="8,0,3,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Party" FontSize="11" Foreground="#D9CFE8" VerticalAlignment="Center"/>
              <Button x:Name="PartyEyeButton" Grid.Column="1" Tag="party" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="PanelEyeButton_Click" ToolTipService.ToolTip="파티 내용 가리기/표시">
                <TextBlock x:Name="PartyEyeIcon" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
              </Button>
              <Button Grid.Column="2" Tag="party" Content="×" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="PanelCloseButton_Click" ToolTipService.ToolTip="파티 패널 닫기"/>
            </Grid>
          </Border>
          <ScrollViewer x:Name="PartyBody" Grid.Row="1" Height="70" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Padding="12" Spacing="7">
              <TextBlock x:Name="PartyText" Text="파티 정보 없음" FontSize="11" Foreground="#BDB1D0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="PartyResizeHandles" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Tag="party:left" Width="7" HorizontalAlignment="Left" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Left" Background="#70FFFFFF"/></Border>
            <Border Tag="party:right" Width="7" HorizontalAlignment="Right" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Right" Background="#70FFFFFF"/></Border>
            <Border Tag="party:top" Height="7" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Top" Background="#70FFFFFF"/></Border>
            <Border Tag="party:bottom" Height="7" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Bottom" Background="#70FFFFFF"/></Border>
            <Border Tag="party:topleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="party:topright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="party:bottomleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="party:bottomright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Native input diagnostic (F) only. -->
      <Border x:Name="ClickNativePanel" Width="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,425,0,0" CornerRadius="10" Background="#E6141020" BorderBrush="#507B5AA6" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform x:Name="ClickNativePanelTransform"/></Border.RenderTransform>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="ClickNativeMoveBar" Height="24" Background="#E6141020" BorderBrush="#507B5AA6" BorderThickness="0,0,0,1" Tag="click-native" PointerPressed="PanelMoveBar_PointerPressed" PointerMoved="PanelMoveBar_PointerMoved" PointerReleased="PanelMoveBar_PointerReleased" PointerCanceled="PanelMoveBar_PointerCanceled" PointerCaptureLost="PanelMoveBar_PointerCaptureLost">
            <Grid Padding="8,0,3,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Native Input" FontSize="11" Foreground="#D9CFE8" VerticalAlignment="Center"/>
              <Button x:Name="ClickNativeEyeButton" Grid.Column="1" Tag="click-native" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="PanelEyeButton_Click" ToolTipService.ToolTip="상세 내용 표시">
                <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
              </Button>
              <Button Grid.Column="2" Tag="click-native" Content="×" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="PanelCloseButton_Click" ToolTipService.ToolTip="Native Input 패널 닫기"/>
            </Grid>
          </Border>
          <Grid x:Name="ClickNativeBody" Grid.Row="1" Height="70" Padding="10" Background="#B8120F1C">
            <StackPanel Spacing="6">
              <Border x:Name="NativeHookHitbox" Background="#FF5B3E78" CornerRadius="4" Padding="12,8"><TextBlock Text="NATIVE INPUT" Foreground="White" TextAlignment="Center"/></Border>
              <StackPanel x:Name="ClickNativeDetails" Spacing="6" Visibility="Collapsed">
                <ToggleSwitch x:Name="CursorMarkersToggle" Header="마우스 좌표 마커 표시" Toggled="CursorMarkersToggle_Toggled"/>
                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ClickNativeResult" Text="Agent native input waiting" FontSize="10" FontFamily="Consolas" Foreground="#BDB1D0" TextWrapping="Wrap"/></ScrollViewer>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid x:Name="ClickNativeResizeHandles" Grid.RowSpan="2"><Border Tag="click-native:right" Width="7" HorizontalAlignment="Right" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/><Border Tag="click-native:bottom" Height="7" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/><Border Tag="click-native:bottomright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/></Grid>
        </Grid>
      </Border>

      <Border x:Name="YoutubePanel"
              Width="340"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="280,20,0,0"
              CornerRadius="10"
              Background="#FF000000"
              BorderBrush="#507B5AA6"
              BorderThickness="1">
        <Border.RenderTransform>
          <TranslateTransform x:Name="YoutubePanelTransform"/>
        </Border.RenderTransform>
        <Grid Background="Black">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="YoutubeMoveBar" Grid.Row="0" Height="24" Visibility="Collapsed" Background="#E6141020" BorderBrush="#507B5AA6" BorderThickness="0,0,0,1" Tag="youtube"
                  PointerPressed="PanelMoveBar_PointerPressed" PointerMoved="PanelMoveBar_PointerMoved" PointerReleased="PanelMoveBar_PointerReleased" PointerCanceled="PanelMoveBar_PointerCanceled" PointerCaptureLost="PanelMoveBar_PointerCaptureLost">
            <Grid Padding="8,0,3,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="YouTube Player" FontSize="11" Foreground="#D9CFE8" VerticalAlignment="Center"/>
              <Button x:Name="YoutubeSearchButton" Grid.Column="1" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="YoutubeSearchButton_Click" ToolTipService.ToolTip="YouTube에서 영상 찾기">
                <TextBlock x:Name="YoutubeSearchIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
              </Button>
              <Button x:Name="YoutubeNotificationTestButton" Grid.Column="2" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="YoutubeNotificationTestButton_Click" ToolTipService.ToolTip="Game Bar 알림 테스트">
                <TextBlock Text="!" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
              </Button>
              <Button x:Name="YoutubeEyeButton" Grid.Column="3" Tag="youtube" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="PanelEyeButton_Click" ToolTipService.ToolTip="YouTube 내용 가리기/표시">
                <TextBlock x:Name="YoutubeEyeIcon" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
              </Button>
              <Button Grid.Column="4" Tag="youtube" Content="×" Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="PanelCloseButton_Click" ToolTipService.ToolTip="YouTube 패널 닫기"/>
            </Grid>
          </Border>
          <Grid x:Name="YoutubeVideoHost" Grid.Row="1" Height="191" Background="Black">
            <Grid x:Name="YoutubeWebHost">
              <WebView x:Name="YoutubeFallbackWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" NavigationStarting="YoutubeFallbackWebView_NavigationStarting" NavigationCompleted="YoutubeFallbackWebView_NavigationCompleted"/>
            </Grid>
            <Border x:Name="YoutubeInlineState" Background="#C8120F1C" Visibility="Visible">
              <TextBlock x:Name="YoutubeInlineStateText" Text="설정에서 YouTube 영상을 선택해 주세요" Foreground="#D9CFE8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
            </Border>
          </Grid>
          <Grid x:Name="YoutubeResizeHandles" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Tag="youtube:left" Width="7" HorizontalAlignment="Left" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Left" Background="#70FFFFFF"/></Border>
            <Border Tag="youtube:right" Width="7" HorizontalAlignment="Right" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Width="2" HorizontalAlignment="Right" Background="#70FFFFFF"/></Border>
            <Border Tag="youtube:top" Height="7" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Top" Background="#70FFFFFF"/></Border>
            <Border Tag="youtube:bottom" Height="7" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"><Border Height="2" VerticalAlignment="Bottom" Background="#70FFFFFF"/></Border>
            <Border Tag="youtube:topleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="youtube:topright" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
            <Border Tag="youtube:bottomleft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01000000" PointerEntered="ResizeBorder_PointerEntered" PointerExited="ResizeBorder_PointerExited" PointerPressed="PanelResizeBorder_PointerPressed" PointerMoved="PanelResizeBorder_PointerMoved" PointerReleased="PanelResizeBorder_PointerReleased" PointerCanceled="PanelResizeBorder_PointerCanceled" PointerCaptureLost="PanelResizeBorder_PointerCaptureLost"/>
