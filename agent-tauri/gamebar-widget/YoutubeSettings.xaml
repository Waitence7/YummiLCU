<Page x:Class="YummiGameBarWidget.YoutubeSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#F0141020"><StackPanel Padding="20" Spacing="14">
    <TextBlock Text="유미 YouTube 설정" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
    <TextBox x:Name="YoutubeUrlBox" Header="YouTube 링크 또는 영상 ID" PlaceholderText="https://youtu.be/..." KeyDown="YoutubeUrlBox_KeyDown"/>
    <Button Content="영상 적용" Click="YoutubeApplyButton_Click" HorizontalAlignment="Left" Padding="16,8"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="▶ 재생" Click="YoutubePlayButton_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Ⅱ 일시정지" Click="YoutubePauseButton_Click" HorizontalAlignment="Stretch"/></Grid>
    <StackPanel Spacing="4"><TextBlock Text="볼륨" Foreground="White"/><Slider x:Name="YoutubeVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="60" ValueChanged="YoutubeVolumeSlider_ValueChanged"/></StackPanel>
    <TextBlock x:Name="StatusText" Text="영상 위젯과 LCU HUD는 서로 독립적으로 동작합니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
  </StackPanel></Grid>
</Page>
