<Page
    x:Class="YummiGameBarWidget.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="#F0141020" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="20" Spacing="16">
      <TextBlock Text="유미 HUD 설정" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
      <ToggleSwitch x:Name="HudVisibleToggle" Header="HUD 표시" OnContent="표시" OffContent="숨김" Toggled="HudVisibleToggle_Toggled" Foreground="White"/>
      <ToggleSwitch x:Name="CoverageTintToggle" Header="투명 영역 확인" OnContent="옅은 색으로 영역 표시" OffContent="투명하게 표시" Toggled="CoverageTintToggle_Toggled" Foreground="White"/>
      <StackPanel Spacing="4">
        <TextBlock Text="HUD 불투명도" Foreground="White"/>
        <Slider x:Name="HudOpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" Value="100" ValueChanged="HudOpacitySlider_ValueChanged"/>
      </StackPanel>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="효과음" Foreground="White" FontWeight="SemiBold"/>
          <ToggleSwitch x:Name="OverlaySoundEffectsToggle" Header="핑/알림 효과음" OnContent="켜짐" OffContent="꺼짐" Toggled="OverlaySoundEffectsToggle_Toggled" Foreground="White"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="효과음 볼륨" Foreground="White"/><TextBlock x:Name="OverlaySoundEffectsVolumeText" Grid.Column="1" Text="65%" Foreground="#CDBDE8"/></Grid>
          <Slider x:Name="OverlaySoundEffectsVolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" Value="65" ValueChanged="OverlaySoundEffectsVolumeSlider_ValueChanged"/>
          <TextBlock Text="웹 시청자의 핑과 오버레이 알림에 사용합니다. Riot 원본 음원은 사용하지 않습니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Button x:Name="CompactHudButton" Content="핀·위치 조절용으로 줄이기" Click="CompactHudButton_Click" Padding="16,8"/>
      <TextBlock Text="핀이나 제목줄이 안 보이면 먼저 작게 줄여 주세요. HUD 제목줄에서 핀과 위치를 조절한 뒤 다시 확대하면 선택한 위치를 유지합니다." Foreground="#BDB1D0" TextWrapping="Wrap"/>
      <Button x:Name="FitHudButton" Content="Game Bar 최대 크기로 맞추기" Click="FitHudButton_Click" Padding="16,8"/>
      <TextBlock x:Name="PreferenceStatusText" Foreground="#CDBDE8" TextWrapping="Wrap"/>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="9">
          <TextBlock Text="패널 표시" Foreground="White" FontWeight="SemiBold"/>
          <ToggleSwitch x:Name="LcuVisibleToggle" Header="LCU 패널" OnContent="표시" OffContent="숨김" Toggled="LcuVisibleToggle_Toggled" Foreground="White"/>
          <ToggleSwitch x:Name="PartyVisibleToggle" Header="파티 패널" OnContent="표시" OffContent="숨김" Toggled="PartyVisibleToggle_Toggled" Foreground="White"/>
          <ToggleSwitch x:Name="BrowserVisibleToggle" Header="Chrome 탭" OnContent="표시" OffContent="숨김" Toggled="BrowserVisibleToggle_Toggled" Foreground="White"/>
          <ToggleSwitch x:Name="NativeInputVisibleToggle" Header="Native Input 테스트 패널" OnContent="표시" OffContent="숨김" Toggled="NativeInputVisibleToggle_Toggled" Foreground="White"/>
          <ToggleSwitch x:Name="VoiceChatVisibleToggle" Header="Discord Chat" OnContent="표시" OffContent="숨김" Toggled="VoiceChatVisibleToggle_Toggled" Foreground="White"/>
          <TextBlock Text="눈 버튼은 게임 화면에서 숨기고 Win+G에서는 60% 고스트로 남깁니다. × 버튼은 패널을 완전히 닫으며 여기서 다시 켤 수 있습니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="10">
          <TextBlock Text="Discord 채팅" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="Discord Chat도 다른 패널처럼 눈 버튼/설정 토글로 실제 화면 표시를 제어하고, ×로 닫을 수 있습니다. 실제 고정 오버레이에서는 켜진 상태에서 새 메시지가 있을 때만 나타납니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
          <StackPanel Spacing="4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="메시지 표시 시간" Foreground="White"/>
              <TextBlock x:Name="VoiceChatLifetimeValueText" Grid.Column="1" Text="10초" Foreground="#CDBDE8"/>
            </Grid>
            <Slider x:Name="VoiceChatLifetimeSlider" Minimum="3" Maximum="60" StepFrequency="1" Value="10" ValueChanged="VoiceChatLifetimeSlider_ValueChanged"/>
          </StackPanel>
          <TextBlock Text="배경색" Foreground="White"/>
          <ColorPicker x:Name="VoiceChatBackgroundColorPicker" IsAlphaEnabled="False" ColorChanged="VoiceChatBackgroundColorPicker_ColorChanged"/>
          <StackPanel Spacing="4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="배경 불투명도" Foreground="White"/>
              <TextBlock x:Name="VoiceChatBackgroundOpacityValueText" Grid.Column="1" Text="0%" Foreground="#CDBDE8"/>
            </Grid>
            <Slider x:Name="VoiceChatBackgroundOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" Value="0" ValueChanged="VoiceChatBackgroundOpacitySlider_ValueChanged"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="9">
          <TextBlock Text="YouTube 화면" Foreground="White" FontWeight="SemiBold"/>
          <ToggleSwitch x:Name="YoutubeVisibleToggle" Header="YouTube 패널 표시" OnContent="표시" OffContent="숨김" Toggled="YoutubeVisibleToggle_Toggled" Foreground="White"/>
          <TextBox x:Name="YoutubeUrlBox" Header="영상 링크 또는 ID" PlaceholderText="https://youtu.be/..." KeyDown="YoutubeUrlBox_KeyDown"/>
          <Button Content="영상 적용" Click="YoutubeApplyButton_Click" HorizontalAlignment="Left" Padding="16,7"/>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="▶ 재생" Click="YoutubePlayButton_Click" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="Ⅱ 일시정지" Click="YoutubePauseButton_Click" HorizontalAlignment="Stretch"/>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Text="볼륨" Foreground="White"/>
            <Slider x:Name="YoutubeVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="60" ValueChanged="YoutubeVolumeSlider_ValueChanged"/>
          </StackPanel>
          <TextBlock x:Name="YoutubeSettingsStatusText" Text="YouTube는 유미 위젯 안의 작은 카드로 표시됩니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="F9: 전체 오버레이 UI 표시/숨김 · F8: 투명 영역 확인. F9은 게임이 포커스된 상태에서도 유미지지 데스크톱이 감지합니다. 게임 클릭 통과는 Game Bar 상단의 클릭 통과 버튼에서 켜 주세요." Foreground="#BDB1D0" TextWrapping="Wrap"/>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="오버레이 업데이트" Foreground="White" FontWeight="SemiBold"/>
          <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdateButton_Click" HorizontalAlignment="Left" Padding="16,7"/>
          <TextBlock x:Name="UpdateStatusText" Foreground="#B9AAD2" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="#3A241F35" BorderBrush="#805A4C78" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="개발 도구" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="오버레이가 ApplicationData.LocalSettings에 저장한 사용자 값을 초기화합니다. Game Bar 호스트가 별도로 기억하는 위젯 창 위치/크기는 Windows 쪽 상태이므로 이 버튼으로 직접 삭제되지는 않습니다." Foreground="#B9AAD2" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ResetSavedStateButton" Content="사용자 저장값 초기화" Click="ResetSavedStateButton_Click" Padding="14,7"/>
            <Button x:Name="RefreshResizeLogButton" Content="사이즈 로그 새로고침" Click="RefreshResizeLogButton_Click" Padding="14,7"/>
          </StackPanel>
          <TextBlock x:Name="DeveloperStatusText" Foreground="#D4C1EC" TextWrapping="Wrap"/>
          <TextBlock Text="사이즈 조절 로그" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
          <TextBox x:Name="ResizeLogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" Height="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
