<Page
    x:Class="YummiGameBarWidget.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="#F0141020" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="20" Spacing="16">
      <TextBlock Text="유미 HUD 설정" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
      <ToggleSwitch x:Name="HudVisibleToggle" Header="HUD 표시" OnContent="표시" OffContent="숨김" Toggled="HudVisibleToggle_Toggled" Foreground="White"/>
      <ToggleSwitch x:Name="CoverageTintToggle" Header="투명 영역 확인" OnContent="옅은 색으로 영역 표시" OffContent="투명하게 표시" Toggled="CoverageTintToggle_Toggled" Foreground="White"/>
      <StackPanel Spacing="4">
        <TextBlock Text="HUD 불투명도" Foreground="White"/>
        <Slider x:Name="HudOpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" Value="100" ValueChanged="HudOpacitySlider_ValueChanged"/>
      </StackPanel>
      <Button x:Name="CompactHudButton" Content="핀·위치 조절용으로 줄이기" Click="CompactHudButton_Click" Padding="16,8"/>
      <TextBlock Text="핀이나 제목줄이 안 보이면 먼저 작게 줄여 주세요. HUD 제목줄에서 핀을 켠 뒤 아래 버튼으로 다시 확대할 수 있습니다." Foreground="#BDB1D0" TextWrapping="Wrap"/>
      <Button x:Name="FitHudButton" Content="Game Bar 최대 크기로 맞추기" Click="FitHudButton_Click" Padding="16,8"/>
      <TextBlock x:Name="PreferenceStatusText" Foreground="#CDBDE8" TextWrapping="Wrap"/>
      <TextBlock Text="설정은 Game Bar를 연 상태에서 조작할 수 있습니다. 게임 클릭 통과는 Game Bar 상단의 클릭 통과 버튼에서 켜 주세요." Foreground="#BDB1D0" TextWrapping="Wrap"/>
      <Border Background="#342A203A" CornerRadius="10" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="오버레이 업데이트" Foreground="White" FontWeight="SemiBold"/>
          <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdateButton_Click" HorizontalAlignment="Left" Padding="16,7"/>
          <TextBlock x:Name="UpdateStatusText" Foreground="#B9AAD2" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
