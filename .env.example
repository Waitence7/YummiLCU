# Relay (서버 VM) — 복사: cp .env.example .env
# 절대 .env 를 git 에 커밋하지 마세요.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://yummi.duckdns.org/auth/callback

RELAY_HOST=127.0.0.1
RELAY_PORT=8790
RELAY_PUBLIC_BASE_URL=https://yummi.duckdns.org

# 32바이트 이상 랜덤 문자열 (openssl rand -hex 32)
RELAY_INTERNAL_SECRET=

REDIS_URL=redis://127.0.0.1:6379/0
# Discord 로그인 세션 유지 (초). 30일=2592000, 7일=604800. 에이전트 ping 으로 연장됨.
RELAY_SESSION_TTL_SEC=2592000

# 내전 커스텀 매치 종료 시 LCU → Tournament API 자동 전송
TOURNAMENT_API_BASE_URL=http://127.0.0.1:4000
TOURNAMENT_BOT_INTERNAL_TOKEN=
