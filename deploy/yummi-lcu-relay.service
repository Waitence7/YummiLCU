[Unit]
Description=YummiLcu Relay (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Yummi/YummiLcu
EnvironmentFile=/home/ubuntu/Yummi/YummiLcu/.env
ExecStart=/home/ubuntu/Yummi/YummiLcu/.venv/bin/yummi-lcu-relay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
